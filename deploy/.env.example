# Instale como /etc/aven/estoque-campo.env e preencha com valores reais.
# NUNCA suba o arquivo de ambiente real pro Git — ele contem segredos.

APP_ENV=production
APP_DATA_DIR=/var/lib/estoque-campo
ENABLE_API_DOCS=false

# Senha do PostgreSQL que você criou no banco
DATABASE_URL=postgresql://estoque_user:SENHA_FORTE_AQUI@localhost/estoque_campo

# Senha do primeiro usuario de gerencia criado pelo bootstrap inicial.
ADMIN_SENHA=troque-esta-senha-por-algo-forte-e-unico
ADMIN_LOGIN=admin

# Obrigatorios em producao. Gere valores longos, aleatorios e diferentes.
JWT_SECRET_KEY=COLOQUE_UMA_CHAVE_JWT_FORTE_AQUI
JWT_EXPIRE_HOURS=24
AVEN_MONITOR_API_TOKEN=COLOQUE_UM_TOKEN_EXCLUSIVO_DO_MONITOR_AQUI

# Liste apenas origens realmente usadas. "null" atende o Electron local e
# http://localhost atende o WebView/Capacitor; ajuste depois do teste real.
CORS_ALLOWED_ORIGINS=https://estoque.suaempresa.com.br,http://localhost,capacitor://localhost,null
ALLOWED_HOSTS=estoque.suaempresa.com.br
