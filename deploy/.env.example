# Copie este arquivo pra ".env" no VPS e preencha com valores reais.
# NUNCA suba o arquivo ".env" de verdade pro Git — ele tem senhas.

# Senha do PostgreSQL que você criou no banco
DATABASE_URL=postgresql://estoque_user:SENHA_FORTE_AQUI@localhost/estoque_campo

# Senha do painel admin (troque "admin123" por algo forte — é o que protege
# TODAS as rotas administrativas: criar técnico, aprovar, atribuir OS, etc.)
ADMIN_SENHA=troque-esta-senha-por-algo-forte-e-unico
