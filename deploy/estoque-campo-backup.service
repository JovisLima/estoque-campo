[Unit]
Description=Backup do Estoque de Campo
After=postgresql.service
Requires=postgresql.service

[Service]
Type=oneshot
User=lima
Group=lima
EnvironmentFile=/etc/aven/estoque-campo.env
Environment=BACKUP_ROOT=/var/backups/estoque-campo
ExecStart=/opt/estoque-campo/deploy/backup.sh
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/estoque-campo /var/backups/estoque-campo
