# Instale como /etc/aven/estoque-campo-backup.env com permissao 0600.
# Use um usuario/chave limitado somente ao prefixo de backup.
BACKUP_S3_URI=s3://SEU_BUCKET/aven/estoque-campo
AWS_ACCESS_KEY_ID=PREENCHER
AWS_SECRET_ACCESS_KEY=PREENCHER
AWS_DEFAULT_REGION=sa-east-1
# Para S3 compativel (opcional):
# AWS_ENDPOINT_URL=https://endpoint.exemplo.com
